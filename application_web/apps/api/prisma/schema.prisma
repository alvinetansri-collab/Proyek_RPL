datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Land {
  id                 String             @id @default(uuid())
  nomorSertifikat    String             @unique
  alamat             String
  desaKelurahan      String
  kecamatan          String
  kabupatenKota      String
  provinsi           String
  luasTanah          Float
  jenisHak           String
  statusAdministrasi String
  statusKelengkapan  String             @default("Belum Lengkap")
  createdAt          DateTime           @default(now())
  owners             Owner[]
  documents          Document[]
  histories          OwnershipHistory[]
}

model Owner {
  id                  String   @id @default(uuid())
  landId              String
  land                Land     @relation(fields: [landId], references: [id], onDelete: Cascade)
  namaPemilik         String
  nik                 String
  alamat              String
  nomorTelepon        String
  statusPemilikSaatIni Boolean @default(true)
  createdAt           DateTime @default(now())
}

model Document {
  id             String   @id @default(uuid())
  landId         String
  land           Land     @relation(fields: [landId], references: [id], onDelete: Cascade)
  jenisDokumen   String
  nomorDokumen   String
  tanggalDokumen String
  pemilikTerkait String
  createdAt      DateTime @default(now())
}

model OwnershipHistory {
  id                String   @id @default(uuid())
  landId            String
  land              Land     @relation(fields: [landId], references: [id], onDelete: Cascade)
  pemilikSebelumnya String
  pemilikBaru       String
  tanggalPerubahan  String
  jenisPeralihan    String
  dokumenPendukung  String
  createdAt         DateTime @default(now())
}