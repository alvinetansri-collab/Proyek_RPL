{
  "name": "proyek-rpl",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "build:shared": "npm run build --prefix packages/shared",
    "build:api": "npm run build --prefix apps/api",
    "build:web": "npm run build --prefix apps/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "test": "node --test tests/**/*.test.ts",
    "test:feat1": "node --test tests/feature-1-search-registration/feature1-search-registration.test.ts",
    "test:feat2": "node --test tests/feature-2-completeness-timeline/feature2-completeness-timeline.test.ts",
    "test:us1": "node --test tests/us1-land-registration/us1-land-registration.test.ts",
    "test:us2": "node --test tests/us2-land-search-filter/us2-land-search-filter.test.ts",
    "test:us3": "node --test tests/us3-document-completeness/us3-document-completeness.test.ts",
    "test:us4": "node --test tests/us4-ownership-timeline/us4-ownership-timeline.test.ts",
    "test:us5": "node --test tests/us5-document-management-metrics/us5-document-management-metrics.test.ts"
  }
}